@using System.Globalization
@using SenangMemberApp.Shared.Components.AuthRoute
@using SenangMemberApp.Shared.Infrastructure.Firebase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IPushNotificationNavigationService PushNavigation
@inject IPushDeviceRegistrationService PushDeviceRegistration

<Router AppAssembly="typeof(Layout.MainLayout).Assembly">
    <Found Context="routeData">
        <AuthenticatedRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <AuthNotFoundRouteHandler />
    </NotFound>
</Router>

@code {
    protected override void OnInitialized()
    {
        PushNavigation.NavigationRequested += OnPushNavigationRequested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Try to get the saved language, default to English if empty
            var savedCulture = await JS.InvokeAsync<string>("localStorage.getItem", "selectedCulture");
            var culture = string.IsNullOrEmpty(savedCulture) ? "en-US" : savedCulture;

            _ = PushDeviceRegistration.UpdatePreferredLanguageAsync(culture);

            if (CultureInfo.CurrentCulture.Name != culture)
            {
                var cultureInfo = new CultureInfo(culture);
                CultureInfo.DefaultThreadCurrentCulture = cultureInfo;
                CultureInfo.DefaultThreadCurrentUICulture = cultureInfo;

                // Refresh the UI to apply the loaded culture
                StateHasChanged();
            }

            NavigateToPendingNotification();
        }
    }

    private void OnPushNavigationRequested() =>
        _ = InvokeAsync(NavigateToPendingNotification);

    private void NavigateToPendingNotification()
    {
        if (PushNavigation.TryDequeueRoute(out var route) && !string.IsNullOrWhiteSpace(route))
        {
            NavigationManager.NavigateTo(route);
        }
    }

    public void Dispose()
    {
        PushNavigation.NavigationRequested -= OnPushNavigationRequested;
    }
}
