@page "/ChatBot"
@using SenangMemberApp.Shared.Models
@using System.Net.Http.Json
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.DependencyInjection
@using SenangMemberApp.Shared.Services.IService
@using SenangMemberApp.Shared.Models.DTO
@using Microsoft.Extensions.Localization
@inject IConfiguration Config
@inject HttpClient Http
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavManager
@inject IUserProfileService UserProfileService
@inject IStringLocalizer<Chat> Loc
@layout EmptyLayout


<div class="chat-wrapper">
    <div class="chat-header">
        <div class="header-content">
            <button class="btn-back" @onclick="GoBack" aria-label="Go back">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </button>
            <div class="avatar">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            </div>
            <div class="header-info">
                <h3>@Loc["AdministrativeAI"]</h3>
                <span>@Loc["AlwaysHereToHelp"]</span>
            </div>
        </div>
    </div>

    @if (IsInitializing)
    {
        <div class="login-container">
            @if (string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="spinner-container" style="display: flex; justify-content: center; align-items: center; min-height: 100px;">
                    <div class="loader"></div>
                </div>
                <p style="color: var(--text-dark); margin-top: 20px; opacity: 0.8; font-weight: 500;">@InitStatusMessage</p>
            }
            else
            {
                <div style="color: #b91c1c; margin-bottom: 20px; font-weight: 600; font-size: 1.1rem; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" style="color: #b91c1c;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div>@ErrorMessage</div>
                </div>
                <button @onclick="LoadProfileAndStartChat" class="login-btn">@Loc["Retry"]</button>
            }
        </div>
    }
    else
    {

        <div class="chat-messages" id="chat-messages-container">
            @foreach (var msg in Messages)
            {
                bool isLatestBotMsg = msg == Messages.LastOrDefault(m => m.Sender == "Bot");

                <div class="message-row @GetRowClass(msg.Sender)">
                    @if (msg.Sender == "Bot")
                    {
                        <div class="message-avatar bot-avatar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                        </div>
                    }

                    <div class="message-content-wrapper">
                        <div class="bubble @GetBubbleClass(msg.Sender)">
                            @if (msg.IsTyping)
                            {
                                <div class="typing-indicator">
                                    <span></span><span></span><span></span>
                                </div>
                            }
                            else
                            {
                                <div class="message-content">@((MarkupString)FormatMessage(msg.Content, msg.AllowsMultipleAppointmentSelection))</div>
                            }
                        </div>

                        @if (msg.QuickReplies != null && msg.QuickReplies.Any() && !msg.IsTyping && msg.Sender == "Bot")
                        {
                            @if (msg.IsIdSelection)
                            {
                                @* Appointment ID quick-pick pills *@
                                <div class="id-pills-label">@Loc["TapIdToSelect"]</div>
                                <div class="quick-replies-container id-pills-container">
                                    @foreach (var aptId in msg.QuickReplies)
                                    {
                                        <button class="btn-appt-id-pill"
                                                @onclick="() => SelectAppointmentId(aptId, msg)"
                                                disabled="@(IsProcessing || !isLatestBotMsg)">
                                            <span class="pill-icon">🔖</span>
                                            @aptId
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="quick-replies-container">
                                    @foreach (var reply in msg.QuickReplies)
                                    {
                                        <button class="btn-quick-reply"
                                                @onclick="() => SendQuickReply(reply)"
                                                disabled="@(IsProcessing || !isLatestBotMsg)">
                                            @reply
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="chat-input-container">
            <button id="chat-jump-latest"
                    class="btn-jump-latest"
                    @onclick="JumpToLatestAsync"
                    type="button"
                    aria-label="@Loc["JumpToLatest"]"
                    title="@Loc["JumpToLatest"]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                     stroke-linejoin="round" width="20" height="20" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
            <div class="input-wrapper">
                <input id="chat-user-input"
                       @ref="chatInput"
                       type="text"
                       @bind="UserInput"
                       @bind:event="oninput"
                       @onkeypress="HandleKeyPress"
                       disabled="@IsProcessing"
                       placeholder="@Loc["TypeMessagePlaceholder"]"
                       autocomplete="off" />

                <!-- NEW: Microphone Button -->
                <button class="btn-send btn-mic @(IsRecording ? "recording" : "")" @onclick="ToggleRecording" disabled="@(IsProcessing && !IsRecording)">
                    @if (IsRecording)
                    {
                        <!-- Stop Recording Square Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                            <rect x="6" y="6" width="12" height="12" rx="2"></rect>
                        </svg>
                    }
                    else
                    {
                        <!-- Start Mic Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" y1="19" x2="12" y2="22"></line>
                        </svg>
                    }
                </button>

                <button class="btn-send" @onclick="SendMessage" disabled="@(IsSendDisabled ? "disabled" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(VoiceErrorMessage))
            {
                <div class="voice-error-message">@VoiceErrorMessage</div>
            }
        </div>
    }
</div>


@code {
    private string VoiceErrorMessage { get; set; } = "";

    private void GoBack()
    {
        NavManager.NavigateTo("/appointment");
    }

    private bool IsInitializing { get; set; } = true;
    private string InitStatusMessage { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAndStartChat();
    }

    private async Task LoadProfileAndStartChat()
    {
        IsInitializing = true;
        ErrorMessage = "";
        InitStatusMessage = Loc["LoadingProfile"];
        StateHasChanged();

        try
        {
            var response = await UserProfileService.GetUserProfile();
            if (response != null && response.result != null && !string.IsNullOrEmpty(response.result.Phone))
            {
                LoginPhone = response.result.Phone;
                InitStatusMessage = Loc["SyncingAppointments"];
                StateHasChanged();
                
                await StartChat();
                
                if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    IsInitializing = true;
                }
                else
                {
                    IsInitializing = false;
                }
            }
            else
            {
                ErrorMessage = Loc["NoPhoneFound"];
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"{Loc["InitFailed"]} {ex.Message}";
            Console.WriteLine($"Error loading user profile for auto-login: {ex.Message}");
        }
        finally
        {
            if (!string.IsNullOrEmpty(ErrorMessage))
            {
                IsInitializing = true;
            }
            else if (!string.IsNullOrEmpty(CustomerId))
            {
                IsInitializing = false;
            }
            StateHasChanged();
        }
    }

    private string CustomerId { get; set; } = "";
    private string _loginPhone = "";
    private string LoginPhone
    {
        get => _loginPhone;
        set
        {
            if (string.IsNullOrEmpty(value))
            {
                _loginPhone = "";
                return;
            }
            var sb = new System.Text.StringBuilder();
            for (int i = 0; i < value.Length; i++)
            {
                if (sb.Length >= 13) break;
                char c = value[i];
                if (c == '+' && sb.Length == 0)
                {
                    sb.Append(c);
                }
                else if (char.IsDigit(c))
                {
                    sb.Append(c);
                }
            }
            _loginPhone = sb.ToString();
        }
    }

    private List<ChatMessage> Messages { get; set; } = new();
    private string UserInput { get; set; } = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private bool IsRecording { get; set; } = false;
    private string ErrorMessage { get; set; } = "";
    private ElementReference chatInput;
    private bool IsScrollTrackingInitialized;

    private bool IsSendDisabled => IsProcessing || string.IsNullOrWhiteSpace(UserInput);
    private string GetRowClass(string sender) => sender == "User" ? "row-user" : "row-bot";
    private string GetBubbleClass(string sender) => sender == "User" ? "bubble-user" : "bubble-bot";

    private string GetApiUrl(string endpoint)
    {
        var baseUrl = Config["ApiBaseUrl"]?.TrimEnd('/') ?? "https://60.49.248.21:43250";
        return $"{baseUrl}/{endpoint}";
    }

    private string FormatMessage(string text, bool showAppointmentAddIcons = false)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;

        // Keep the chatbot's booking and modification summaries readable even
        // when a transport has flattened their line breaks. This mirrors the
        // current chatbot response layout for English, Malay, and Mandarin.
        const string detailsHeading = @"(?:Booking details|Appointment details|预约详情|Butiran temu janji)";
        const string detailLabel = @"(?:Appointment ID|Branch|Date|Time|Service|Staff|预约编号|分店|日期|时间|服务|员工|ID temu janji|Cawangan|Tarikh|Masa|Perkhidmatan|Staf)";

        if (System.Text.RegularExpressions.Regex.IsMatch(
                text,
                $@"\*{detailsHeading}\*",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            text = System.Text.RegularExpressions.Regex.Replace(
                text,
                $@"[ \t]*(\*{detailsHeading}\*)[ \t]*",
                "\n\n$1\n",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            text = System.Text.RegularExpressions.Regex.Replace(
                text,
                $@"[ \t\r\n]*[\u2022\u00B7]\s*(?={detailLabel}\s*[:：])",
                "\n\u2022 ",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            text = System.Text.RegularExpressions.Regex.Replace(
                text,
                $@"(({detailLabel})\s*[:：]\s*\*[^*\r\n]+\*)[ \t]+(?=\S)",
                "$1\n\n",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\n{3,}", "\n\n");
        }

        var encoded = System.Net.WebUtility.HtmlEncode(text);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*(.*?)\*", "<b>$1</b>");
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"_(.*?)_", "<i>$1</i>");
        encoded = encoded.Replace("\n", "<br/>");

        if (showAppointmentAddIcons)
        {
            encoded = System.Text.RegularExpressions.Regex.Replace(
                encoded,
                @"(?<=[:ï¼š]\s)((?:HQ|APT)\d+)",
                m =>
                {
                    var id = m.Groups[1].Value;
                    var numericPart = System.Text.RegularExpressions.Regex.Match(id, @"\d+$").Value;
                    var shortCode = long.TryParse(numericPart, out var numericId) ? numericId.ToString() : id;
                    var addIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='13' height='13'>" +
                                  "<rect x='9' y='9' width='13' height='13' rx='2' ry='2'></rect>" +
                                  "<path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 0 2 2v1'></path>" +
                                  "</svg>";
                    return "<span class='appt-id-wrapper'><span class='appt-id'>" + id + "</span>" +
                           "<button type='button' class='btn-add-appt' onclick=\"window.addAppointmentIdToInput('" + shortCode + "')\" data-appointment-short-code='" + shortCode +
                           "' title='Add " + shortCode + " to message' aria-label='Add appointment " + shortCode + " to message'>" +
                           addIcon + "</button></span>";
                });
        }

        if (encoded.Length < 0) // Legacy clipboard behavior: retained only for source-history reference.
        {
        // Wrap APT IDs that appear as real IDs (after ": ") with an inline copy button.
        // Positive lookbehind (?<=:\s) excludes example text like "e.g., APT00001".
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"(?<=[:：]\s)((?:HQ|APT)\d+)",
            m =>
            {
                var id = m.Groups[1].Value;
                // On click: copy to clipboard, then show a static "copied" text for 1 second next to button (debounced)
                var js = "var btn=this;navigator.clipboard.writeText('" + id + "').then(function(){" +
                         "var existing=btn.parentNode.querySelector('.copy-feedback');" +
                         "if(existing){" +
                         "clearTimeout(existing.timeoutId);" +
                         "existing.timeoutId=setTimeout(function(){existing.remove();},1000);" +
                         "}else{" +
                         "var t=document.createElement('span');" +
                         "t.className='copy-feedback';" +
                         "t.style.color='#15803d';" +
                         "t.style.fontSize='0.75rem';" +
                         "t.style.fontWeight='600';" +
                         "t.style.marginLeft='5px';" +
                         "t.textContent='copied';" +
                         "btn.parentNode.appendChild(t);" +
                         "t.timeoutId=setTimeout(function(){t.remove();},1500);}});";
                var clipIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='13' height='13'>" +
                               "<rect x='9' y='9' width='13' height='13' rx='2' ry='2'></rect>" +
                               "<path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'></path>" +
                               "</svg>";
                return "<span class='appt-id-wrapper'>" +
                       "<span class='appt-id'>" + id + "</span>" +
                       "<button class='btn-copy-appt' onclick=\"" + js + "\" title='Copy " + id + "'>" +
                       clipIcon +
                       "</button>" +
                       "</span>";
            }
        );

        }

        return encoded;
    }

    private async Task StartChat()
    {
        if (string.IsNullOrWhiteSpace(LoginPhone)) return;

        IsProcessing = true;

        try
        {
            /*
            var repo = ServiceProvider.GetService<AppointmentRepository>();
            var orchestrator = ServiceProvider.GetService<ChatOrchestrator>();

            if (repo != null && orchestrator != null)
            {
                // Local execution
                var cleanPhone = LoginPhone.Trim().Replace("+", "").Replace("-", "").Replace(" ", "");
                if (cleanPhone.StartsWith("0"))
                {
                    cleanPhone = "6" + cleanPhone;
                }
                var customerId = await repo.GetCustomerByPhoneFuzzyAsync(cleanPhone);

                if (string.IsNullOrEmpty(customerId))
                {
                    customerId = await repo.CreateCustomerAsync("", cleanPhone);
                }

                var welcomeMessage = await orchestrator.GetWelcomeMessageAsync(customerId);
                
                CustomerId = customerId;
                StateHasChanged();
                await Task.Delay(20);

                Messages.Add(new ChatMessage
                {
                    Sender = "Bot",
                    Content = welcomeMessage.Message,
                    QuickReplies = welcomeMessage.QuickReplies,
                    IsIdSelection = welcomeMessage.IsIdSelection,
                    AllowsMultipleAppointmentSelection = welcomeMessage.AllowsMultipleAppointmentSelection
                });
            }
            else
            */
            {
                // HTTP execution
                var loginReq = new LoginRequest
                {
                    Phone = LoginPhone,
                    Language = System.Globalization.CultureInfo.CurrentUICulture.Name
                };
                var response = await Http.PostAsJsonAsync(GetApiUrl("api/chat/login"), loginReq);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                    if (result != null)
                    {
                        CustomerId = result.CustomerId;

                        StateHasChanged();
                        await Task.Delay(20);

                        Messages.Add(new ChatMessage
                        {
                            Sender = "Bot",
                            Content = result.WelcomeMessage.Message,
                            QuickReplies = result.WelcomeMessage.QuickReplies,
                            IsIdSelection = result.WelcomeMessage.IsIdSelection,
                            AllowsMultipleAppointmentSelection = result.WelcomeMessage.AllowsMultipleAppointmentSelection
                        });
                    }
                }
                else
                {
                    ErrorMessage = $"{Loc["ApiError"]} {response.StatusCode}";
                }
            }
        }
        catch (Exception ex)
        { 
            ErrorMessage = $"Error: {ex.Message}";
            Console.WriteLine(ErrorMessage);
        }

        IsProcessing = false;
        StateHasChanged();
        await ScrollToBottomAsync();
        await FocusInputAsync();
    }

    private async Task HandleLoginKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsProcessing)
        {
            await StartChat();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsInitializing && !IsScrollTrackingInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "chatScroll.initialize",
                    "chat-messages-container",
                    "chat-jump-latest");
                IsScrollTrackingInitialized = true;
            }
            catch
            {
                // The DOM or JS runtime can still be starting in a hybrid WebView.
            }
        }

        if (firstRender && !string.IsNullOrEmpty(CustomerId))
        {
            await FocusInputAsync();
        }
    }

    private async Task SendQuickReply(string reply)
    {
        UserInput = reply;
        await SendMessage();
    }

    /// <summary>
    /// Handles clicking an appointment-ID pill button.
    /// - Modify flow: single-ID input → sends immediately.
    /// - Delete flow: multi-ID input → appends the ID to the text box with a comma separator.
    /// </summary>
    private async Task SelectAppointmentId(string aptId, ChatMessage sourceMsg)
    {
        if (IsProcessing) return;

        // Quick-pick buttons always execute immediately. The inline add icon is
        // the control used when a customer wants to prepare multiple IDs.
        UserInput = aptId;
        await SendMessage();
    }

    private async Task ToggleRecording()
    {
        if (!IsRecording)
        {
            VoiceErrorMessage = "";
            bool hasMic;
            try
            {
                hasMic = await JS.InvokeAsync<bool>("audioRecorder.start");
            }
            catch (Exception ex)
            {
                VoiceErrorMessage = $"Microphone could not start: {ex.Message}";
                StateHasChanged();
                return;
            }

            if (hasMic)
            {
                IsRecording = true;
                StateHasChanged();
            }
            else
            {
                VoiceErrorMessage = "Microphone access is unavailable. Allow microphone access and try again.";
                StateHasChanged();
            }
        }
        else
        {
            IsRecording = false;
            IsProcessing = true;
            StateHasChanged();
            
            string base64Json;
            try
            {
                base64Json = await JS.InvokeAsync<string>("audioRecorder.stopAndGetBase64");
            }
            catch (Exception ex)
            {
                IsProcessing = false;
                VoiceErrorMessage = $"The recording could not be completed: {ex.Message}";
                StateHasChanged();
                return;
            }
            
            if (!string.IsNullOrEmpty(base64Json))
            {
                var voiceBubble = new ChatMessage { Sender = "User", Content = Loc["SendingVoiceMessage"] };
                Messages.Add(voiceBubble);
                StateHasChanged();
                await ScrollToBottomAsync();

                var genericTyping = new ChatMessage { Sender = "Bot", Content = "", IsTyping = true };
                Messages.Add(genericTyping);
                StateHasChanged();
                await ScrollToBottomAsync();
                try
                {
                    string base64Audio = "";
                    string mimeType = "audio/webm";
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(base64Json);
                        var root = doc.RootElement;
                        if (root.TryGetProperty("base64Data", out var dataProp))
                        {
                            base64Audio = dataProp.GetString() ?? "";
                        }
                        if (root.TryGetProperty("mimeType", out var mimeProp))
                        {
                            mimeType = mimeProp.GetString() ?? "audio/webm";
                        }
                    }
                    catch
                    {
                        base64Audio = base64Json;
                    }

                    /*
                    if (orchestrator != null && voiceService != null)
                    {
                        // Local execution
                        byte[] audioBytes = Convert.FromBase64String(base64Audio);
                        string userMessage = await voiceService.TranscribeAudioAsync(audioBytes, mimeType);

                        // Update the user bubble to show what was actually transcribed
                        voiceBubble.Content = $"🎤 {(string.IsNullOrWhiteSpace(userMessage) ? "Sending Voice Message..." : userMessage)}";
                        Messages.Remove(genericTyping);
                        StateHasChanged();

                        if (string.IsNullOrWhiteSpace(userMessage))
                        {
                            Messages.Add(new ChatMessage { Sender = "Bot", Content = Loc["UnderstandAudioError"] });
                        }
                        else
                        {
                            // Show typing animation while the orchestrator processes the transcribed message
                            var processingTyping = new ChatMessage { Sender = "Bot", Content = "", IsTyping = true };
                            Messages.Add(processingTyping);
                            StateHasChanged();
                            await ScrollToBottomAsync();

                            var response = await orchestrator.ProcessInput(userMessage, CustomerId);
                            Messages.Remove(processingTyping);
                            await ProcessBotResponseStream(response);
                        }
                    }
                    else
                    */
                    {
                        // HTTP execution
                        var req = new ChatVoiceRequest { CustomerId = CustomerId, Base64Audio = base64Audio, MimeType = mimeType };
                        var apiResponse = await Http.PostAsJsonAsync(GetApiUrl("api/chat/voice"), req);

                        Messages.Remove(genericTyping);

                        if (apiResponse.IsSuccessStatusCode)
                        {
                            var response = await apiResponse.Content.ReadFromJsonAsync<ChatResponse>();
                            if (response != null)
                            {
                                await ProcessBotResponseStream(response);
                            }
                        }
                    }
                }
                catch
                {
                    Messages.Remove(genericTyping);
                    Messages.Add(new ChatMessage { Sender = "Bot", Content = Loc["VoiceNetworkError"] });
                }
                finally
                {
                    IsProcessing = false;
                    StateHasChanged();
                    await ScrollToBottomAsync();
                    await FocusInputAsync();
                }
            }
            else
            {
                IsProcessing = false;
                VoiceErrorMessage = "The browser could not finish the recording. Please try again.";
                StateHasChanged();
            }
        }
    }

    private async Task ProcessBotResponseStream(ChatResponse response)
    {
        // Render all responses immediately so customers do not wait for a
        // character-by-character animation.
        if (response.AdditionalMessages != null)
        {
            foreach (var extraMsg in response.AdditionalMessages)
            {
                var extraBubble = new ChatMessage { Sender = "Bot", Content = extraMsg, QuickReplies = new List<string>() };
                Messages.Add(extraBubble);
                StateHasChanged();
                await ScrollToBottomAsync();
            }
        }

        // The final message carries the quick-reply buttons.
        var finalMsg = new ChatMessage
        {
            Sender = "Bot",
            Content = response.Message,
            QuickReplies = response.QuickReplies,
            IsIdSelection = response.IsIdSelection,
            AllowsMultipleAppointmentSelection = response.AllowsMultipleAppointmentSelection
        };
        Messages.Add(finalMsg);
        StateHasChanged();
        await ScrollToBottomAsync();
    }

    private async Task SendMessage()
    {
        if (IsSendDisabled) return;

        var userMsg = UserInput;
        UserInput = string.Empty;
        IsProcessing = true;

        Messages.Add(new ChatMessage { Sender = "User", Content = userMsg });
        StateHasChanged();
        await ScrollToBottomAsync();

        var genericTyping = new ChatMessage { Sender = "Bot", Content = "", IsTyping = true };
        Messages.Add(genericTyping);
        StateHasChanged();
        await ScrollToBottomAsync();

        try
        {
            /*
            var orchestrator = ServiceProvider.GetService<ChatOrchestrator>();

            if (orchestrator != null)
            {
                // Local execution
                var response = await orchestrator.ProcessInput(userMsg, CustomerId);
                Messages.Remove(genericTyping);
                await ProcessBotResponseStream(response);
            }
            else
            */
            {
                // HTTP execution
                var req = new ChatMessageRequest { CustomerId = CustomerId, Message = userMsg };
                var apiResponse = await Http.PostAsJsonAsync(GetApiUrl("api/chat/message"), req);

                Messages.Remove(genericTyping);

                if (apiResponse.IsSuccessStatusCode)
                {
                    var response = await apiResponse.Content.ReadFromJsonAsync<ChatResponse>();
                    if (response != null)
                    {
                        await ProcessBotResponseStream(response);
                    }
                }
            }
        }
        catch
        {
            Messages.Remove(genericTyping);
            Messages.Add(new ChatMessage { Sender = "Bot", Content = Loc["NetworkError"] });
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
            await ScrollToBottomAsync();
            await FocusInputAsync();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsProcessing)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "chatScroll.scrollToBottom",
                "chat-messages-container",
                false);
        }
        catch { }
    }

    private async Task JumpToLatestAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "chatScroll.scrollToBottom",
                "chat-messages-container",
                true);
        }
        catch { }
    }

    private async Task FocusInputAsync()
    {
        try { await chatInput.FocusAsync(); } catch { }
    }
}
