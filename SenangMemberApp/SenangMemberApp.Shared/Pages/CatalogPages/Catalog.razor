@page "/catalog"
@using SenangMemberApp.Shared.Models

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Catalog> Loc

<div class="page-wrapper">
    <div class="header">
        <div style="grid-column: 1;"><span class="header-title">@Loc["PageTitle"]</span></div>
        <div style="width: 20px;"></div>
    </div>

    <div class="catalog-grid-wrapper" style="margin-top: 15px;">
        @if (companyCategories.Count == 0)
        {
            <div style="text-align: center; padding: 20px; color: var(--text-muted);">
                @Loc["NoCategoriesFound"]
            </div>
        }
        else
        {
            @foreach (var category in companyCategories)
            {
                <div @onclick="() => navCategory(category.id)" class="catalog-grid-layout">
                    <img class="catalog-image"
                         src="@(string.IsNullOrWhiteSpace(category.imagePath) ? "_content/SenangMemberApp.Shared/Images/store_placeholder.png" : category.imagePath)"
                         onerror="this.onerror=null;this.src='_content/SenangMemberApp.Shared/Images/store_placeholder.png';"
                         alt="@category.description" />
                    <div class="catalog-info-container">
                        <span class="catalog-name">@category.description</span>
                    </div>
                </div>
            }
        }
    </div>
</div>



@if (servicesModalIsOpen)
{
    <div @onclick="closeServiceModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper">
            <div class="modal-top">
                <div class="left-header-div"></div>
                <div class="center-header-div"><span>@Loc["ServiceDetails"]</span></div>
                <div @onclick="closeServiceModal" class="close-button right-header-div" style="cursor: pointer;"><i class="fa-solid fa-xmark"></i></div>
            </div>
            <div class="modal-content">
                <img class="modal-image" src="_content/SenangMemberApp.Shared/Images/store_placeholder.png" />
                <span class="modal-service-name">@serviceToShowInModal.Name</span>
                <span>@serviceToShowInModal.Description</span>
            </div>
        </div>
    </div>
}
