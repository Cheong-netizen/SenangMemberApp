@page "/catalog"
@using SenangMemberApp.Shared.Models

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Catalog> Loc

<div class="page-wrapper">
    <div class="header">
        <div style="grid-column: 1;"><span class="header-title">@Loc["PageTitle"]</span></div>
        <div style="width: 20px;"></div>
    </div>

    <div class="shop-wrapper">
        <div @onclick="() => { if (!loading) toggleShopListModal(); }" class="shop-dropdown" style="@(loading ? "opacity: 0.5; cursor: not-allowed;" : "cursor: pointer;")">
            <div class="shop-dropdown-placeholder">
                @if(loading){
                    <div class="spinner-container">
                        <div class="loader"></div>
                    </div>
                }
                else
                {
                    @if (string.IsNullOrEmpty(currentShopId) || currentShopId == "0")
                    {
                        <span>@Loc["SelectAShop"]</span>
                        <span><i class="fa-solid fa-caret-down"></i></span>
                    }
                    else
                    {
                        <span>@currentShopName</span>
                        <span><i class="fa-solid fa-caret-down"></i></span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="catalog-grid-wrapper" style="margin-top: 15px;">
        @if (companyCategories.Count == 0)
        {
            <div style="text-align: center; padding: 20px; color: var(--text-muted);">
                @Loc["NoCategoriesFound"]
            </div>
        }
        else
        {
            @foreach (var category in companyCategories)
            {
                <div @onclick="() => navCategory(category.id)" class="catalog-grid-layout">
                    <img class="catalog-image" src="@category.imagePath" />
                    <span class="catalog-name">@category.description</span>
                </div>
            }
        }
    </div>
</div>

@if (shopListModalIsOpen)
{
    <div @onclick="toggleShopListModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper">
            <div class="shop-list-wrapper">
                <div class="modal-top">
                    <div class="left-header-div"></div>
                    <div class="center-header-div"><span>@Loc["SelectShop"]</span></div>
                    <div @onclick="toggleShopListModal" class="close-button right-header-div" style="cursor: pointer;">
                        <i class="fa-solid fa-xmark"></i>
                    </div>
                </div>

                <div class="search-wrapper">
                    <div class="search-box">
                        <span><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input class="search-textbox" type="text" placeholder="@Loc["SearchPlaceholder"]" @bind="shopSearchText" @bind:event="oninput" />
                    </div>
                </div>

                <div class="shop-grid-wrapper">
                    @foreach (var shop in filteredShops)
                    {
                        <div @onclick="() => selectShop(shop.CompanyCode, shop.ShopName)" class="shop-grid-layout" style="cursor: pointer;">
                            <img class="shop-image" src="@shop.LogoPath" />
                            <span class="shop-name">@shop.ShopName</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (servicesModalIsOpen)
{
    <div @onclick="closeServiceModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper">
            <div class="modal-top">
                <div class="left-header-div"></div>
                <div class="center-header-div"><span>@Loc["ServiceDetails"]</span></div>
                <div @onclick="closeServiceModal" class="close-button right-header-div" style="cursor: pointer;"><i class="fa-solid fa-xmark"></i></div>
            </div>
            <div class="modal-content">
                <img class="modal-image" src="_content/SenangMemberApp.Shared/Images/store_placeholder.png" />
                <span class="modal-service-name">@serviceToShowInModal.Name</span>
                <span>@serviceToShowInModal.Description</span>
            </div>
        </div>
    </div>
}
