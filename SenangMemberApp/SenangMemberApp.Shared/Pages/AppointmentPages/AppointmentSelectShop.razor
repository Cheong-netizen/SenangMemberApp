@page "/AppointmentSelectShop"
@layout EmptyLayout

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<AppointmentSelectShop> Loc

<div class="page-wrapper">
    <div class="header">
        <div><span @onclick="navBack"><i class="fa-solid fa-angle-left"></i></span></div>
        <div><span>@Loc["PageTitle"]</span></div>
        <div></div>
    </div>
    <div class="search-wrapper">
        <div class="search-box">
            <span><i class="fa-solid fa-magnifying-glass"></i></span>
            <input class="search-textbox" type="text" placeholder="@Loc["SearchPlaceholder"]" @bind="shopSearchText" @bind:event="oninput" />
        </div>
    </div>
    @* <div class="product-grid">
        <div class="product-card">
            <div class="image-wrapper">
                 <img src="_content/SenangMemberApp.Shared/Images/store_placeholder.png" alt="Product Image">
            </div>
            <div class="card-content">
                <span>@Loc["Shop1"]</span>
            </div>
        </div>
     </div> *@
    <div class="shop-grid-wrapper">
        @if (filteredShops != null && filteredShops.Any())
        {
            @foreach (var shop in filteredShops)
            {
                <div @onclick="() => selectShop(shop.CompanyCode, shop.ShopName)" class="shop-grid-layout @(shop.CompanyCode == appointmentState.selectedBookingShopId ? "selected" : "") ">
                    <img class="shop-image" src="@(string.IsNullOrWhiteSpace(shop.LogoPath) ? "_content/SenangMemberApp.Shared/Images/store_placeholder.png" : shop.LogoPath)" />
                    <span class="shop-name">@(shop.ShopName ?? "")</span>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 20px; color: #888; grid-column: 1 / -1;">
                <span>No shops available</span>
            </div>
        }
    </div>
</div>
<div @onclick="navSelectOutlet" class="next-button @(appointmentState.selectedBookingShopId == "" ? "disabled" : "")">
    <div class="next-button-content">
        <span>@Loc["NextButton"]</span>
    </div>
</div>
