@page "/AppointmentSelectStaff"
@using SenangMemberApp.Shared.Models.DTO.CompanyDTO
@layout EmptyLayout

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<AppointmentSelectStaff> Loc

<div class="page-wrapper">
    <div class="header">
        <div><span @onclick="navBack"><i class="fa-solid fa-angle-left"></i></span></div>
        <div><span>@Loc["PageTitle"]</span></div>
        <div></div>
    </div>
    <div class="steps-wrapper">
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer active">
                    <div class="steps-ball-fill">
                        <span>1</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepServices"]</span>
        </div>
        <div class="steps-line active"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer active">
                    <div class="steps-ball-fill">
                        <span>2</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepStaff"]</span>
        </div>
        <div class="steps-line"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer">
                    <div class="steps-ball-fill">
                        <span>3</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepDate"]</span>
        </div>
        <div class="steps-line"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer">
                    <div class="steps-ball-fill">
                        <span>4</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepSummary"]</span>
        </div>
    </div>
    <div class="staff-grid">
        @if (isLoading)
        {
            <div style="grid-column: 1 / -1; display: flex; justify-content: center; align-items: center; min-height: 120px;">
                <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
            </div>
        }
        else if (staffs == null || !staffs.Any())
        {
            <div style="grid-column: 1 / -1; text-align: center; color: #888; padding: 40px 10px;">
                <span>No staff available for this branch</span>
            </div>
        }
        else
        {
            @foreach (var staff in staffs)
            {
                var staffId = !string.IsNullOrEmpty(staff.masterAccountID) ? staff.masterAccountID : (!string.IsNullOrEmpty(staff.displayCode) ? staff.displayCode : staff.salesPersonCode);
                var staffName = !string.IsNullOrWhiteSpace(staff.accountName) ? staff.accountName : staff.salesPersonCode;
                <div @onclick='() => selectStaff(staffId, staffName)' class="staff-card @(selectedStaffId == staffId ? "selected" : "")">
                    <div class="image-wrapper">
                        <img src="@(GetStaffImageUrl(staff.imagePath))" alt="Staff Image" />
                    </div>
                    <div class="card-content">
                        <span>@staffName</span>
                        @if (!string.IsNullOrWhiteSpace(staff.jobTitle))
                        {
                            <span style="font-size: 11px; color: #666; margin-top: 2px;">@staff.jobTitle</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(staff.employeeTypeName))
                        {
                            <span style="font-size: 11px; color: #666; margin-top: 2px;">@staff.employeeTypeName</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
<div @onclick="navSelectDate" class="next-button">
    <div class="next-button-content @(string.IsNullOrWhiteSpace(selectedStaffId) ? "disabled" : "")">
        <span>@Loc["NextButton"]</span>
    </div>
</div>
