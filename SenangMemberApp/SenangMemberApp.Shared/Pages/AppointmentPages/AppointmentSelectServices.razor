@page "/AppointmentSelectServices"
@using SenangMemberApp.Shared.Models
@using SenangMemberApp.Shared.Models.DTO
@layout EmptyLayout

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<AppointmentSelectServices> Loc

<div class="page-wrapper">
    <div class="header">
        <div><span @onclick="navBack" style="cursor: pointer;"><i class="fa-solid fa-angle-left"></i></span></div>
        <div><span>@Loc["PageTitle"]</span></div>
        <div></div>
    </div>
    <div class="steps-wrapper">
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer active">
                    <div class="steps-ball-fill">
                        <span>1</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepServices"]</span>
        </div>
        <div class="steps-line"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer">
                    <div class="steps-ball-fill">
                        <span>2</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepStaff"]</span>
        </div>
        <div class="steps-line"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer">
                    <div class="steps-ball-fill">
                        <span>3</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepDate"]</span>
        </div>
        <div class="steps-line"></div>
        <div class="steps-component">
            <div class="steps-ball">
                <div class="steps-ball-outer">
                    <div class="steps-ball-fill">
                        <span>4</span>
                    </div>
                </div>
            </div>
            <span>@Loc["StepSummary"]</span>
        </div>
    </div>
    <div class="search-wrapper">
        <div class="search-box">
            <span><i class="fa-solid fa-magnifying-glass"></i></span>
            <input class="search-textbox" type="text" placeholder="@Loc["SearchPlaceholder"]" @bind="servicesSearchText" @bind:event="oninput" />
        </div>
    </div>
    <div class="category-filter-bar">
        <button class="category-pill @(string.IsNullOrEmpty(_selectedCategoryId) ? "active" : "")" @onclick='() => FilterByCategory("")'>All</button>
        @foreach (var category in Categories)
        {
            <button class="category-pill @(_selectedCategoryId == category.id ? "active" : "")" @onclick="() => FilterByCategory(category.id)">@category.description</button>
        }
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <span>Loading services...</span>
        </div>
    }
    else if (!FilteredItems.Any())
    {
        <div class="no-services-found">
            <i class="fa-solid fa-magnifying-glass" style="font-size: 2rem; color: var(--text-muted); margin-bottom: 8px;"></i>
            <span>No services found.</span>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var service in FilteredItems)
            {
                var key = GetServiceKey(service);
                var isSelected = SelectedServiceCodes.Contains(key);
                <div class="product-info-wrapper @(isSelected ? "selected" : "")" 
                     @onpointerdown="async (e) => await itemClicked(service, e)" 
                     @onpointerup="() => itemReleased(service)" 
                     @onpointermove="onPointerMove">
                    <img class="service-image"
                         src="@(string.IsNullOrWhiteSpace(service.imagePath) ? "_content/SenangMemberApp.Shared/Images/store_placeholder.png" : service.imagePath)"
                         onerror="this.onerror=null;this.src='_content/SenangMemberApp.Shared/Images/store_placeholder.png';"
                         alt="@service.salesDescription" />
                    <div class="product-info">
                        <span class="product-name">@service.salesDescription</span>
                        @if (!string.IsNullOrWhiteSpace(service.remarks))
                        {
                            <span class="product-info-subtitle">@service.remarks</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(service.itemGroupName))
                        {
                            <span class="product-info-subtitle">@service.itemGroupName</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div @onclick="navSelectStaff" class="next-button">
    <div class="next-button-content @(SelectedServiceCodes.Count != 1 ? "disabled" : "")">
        <span>@Loc["NextButton"]</span>
    </div>
</div>

@if (servicesModalIsOpen && serviceToShowInModal != null)
{
    <div @onclick="closeServiceModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper">
            <div class="modal-top">
                <div></div>
                <div><span>@serviceToShowInModal.salesDescription</span></div>
                <div @onclick="closeServiceModal" class="close-button" style="cursor: pointer;"><i class="fa-solid fa-xmark"></i></div>
            </div>
            <div class="modal-content" style="padding: 20px;">
                <img class="modal-image"
                     src="@(string.IsNullOrWhiteSpace(serviceToShowInModal.imagePath) ? "_content/SenangMemberApp.Shared/Images/store_placeholder.png" : serviceToShowInModal.imagePath)"
                     onerror="this.onerror=null;this.src='_content/SenangMemberApp.Shared/Images/store_placeholder.png';"
                     alt="@serviceToShowInModal.salesDescription"
                     style="max-height: 180px; object-fit: contain; border-radius: 8px;" />
                <div style="width: 100%; display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                    @if (!string.IsNullOrWhiteSpace(serviceToShowInModal.itemGroupName))
                    {
                        <p><strong>Category:</strong> @serviceToShowInModal.itemGroupName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(serviceToShowInModal.itemBrandName))
                    {
                        <p><strong>Brand:</strong> @serviceToShowInModal.itemBrandName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(serviceToShowInModal.remarks))
                    {
                        <p><strong>Description:</strong> @serviceToShowInModal.remarks</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
