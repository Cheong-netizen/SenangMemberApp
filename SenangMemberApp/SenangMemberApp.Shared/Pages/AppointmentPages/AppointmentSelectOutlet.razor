@page "/AppointmentSelectOutlet"
@using SenangMemberApp.Shared.Models
@using SenangMemberApp.Shared.Models.DTO.CompanyDTO
@layout EmptyLayout

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<AppointmentSelectOutlet> Loc

<div class="page-wrapper">
    <div class="header">
        <div><span @onclick="navBack"><i class="fa-solid fa-angle-left"></i></span></div>
        <div><span>@Loc["PageTitle"]</span></div>
        <div></div>
    </div>
    <div class="search-wrapper">
        <div class="search-box">
            <span><i class="fa-solid fa-magnifying-glass"></i></span>
            <input class="search-textbox" type="text" placeholder="@Loc["SearchPlaceholder"]" @bind="outletSearchText" @bind:event="oninput" />
        </div>
    </div>
    <div class="outlets-wrapper">
        @if (filteredOutlets != null)
        {
            @foreach (BranchResponseDTO outlet in filteredOutlets)
            {
                <div @onclick="() => selectOutlet(outlet)" class="outlet-card @(outlet.branchID == appointmentState.selectedOutletId ? "selected" : "") ">
                    <img class="outlet-image" src="_content/SenangMemberApp.Shared/Images/7455353.jpg" />
                    <div class="outlet-info-wrapper">
                        <div class="outlet-info">
                            <span class="outlet-name">@outlet.branch</span>
                            <span class="outlet-address">@outlet.address1</span>
                            <span class="outlet-address">@outlet.address2</span>
                            <span class="outlet-address">@outlet.phone</span>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
    @* <div class="product-grid">
    <div class="product-card">
        <div class="image-wrapper">
             <img src="_content/SenangMemberApp.Shared/Images/7455353.jpg" alt="Product Image">
        </div>
        <div class="card-content">
            <span>@Loc["Outlet1"]</span>
        </div>
    </div>

    <div class="product-card">
        <div class="image-wrapper">
             <img src="_content/SenangMemberApp.Shared/Images/7455353.jpg" alt="Product Image">
        </div>
        <div class="card-content">
            <span>@Loc["Outlet2"]</span>
        </div>
    </div>
    
     </div> *@
</div>
<div @onclick="navSelectServices" class="next-button ">
    <div class="next-button-content @(appointmentState.selectedOutletId == "" ? "disabled" : "")">
        <span>@Loc["NextButton"]</span>
    </div>
</div>

