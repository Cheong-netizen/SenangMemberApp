@page "/History"

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<History> Loc

<div class="page-wrapper">
    <div class="appointment-header">
        @Loc["PageTitle"]
    </div>


    <div class="dropdown-wrapper">
        <select class="modern-select" @onchange="OnMonthSelected" disabled="@loading">
            <option value="0">@Loc["SelectMonth"]</option>
            @if (availableMonth != null)
            {
                @foreach (var month in availableMonth)
                {
                    <option value="@month.yearMonth">@month.yearMonth</option>
                }
            }
        </select>
    </div>

    <div class="history-list-wrapper">
        @if (AllHistory?.result != null && AllHistory.result.Any())
        {
            // 1. Loop through the Dictionary (The Key is the Date string, the Value is the List of items)
            @foreach (var dateGroup in AllHistory.result)
            {
                // 2. Loop through the actual items inside that specific date
                @foreach (var item in dateGroup.Value)
                {
                    <div class="appointment-card history-card mb-3">
                        <div class="appointment-card-header">
                            <div class="appointment-image-name">
                                <div class="appointment-name-info ms-3">
                                    <span class="card-name">@item.branch</span>
                                    <span class="card-branch">@item.itemName</span>
                                </div>
                            </div>
                            <div class="history-price">RM @item.subTotal.ToString("0.00")</div>
                        </div>
                        <div class="appointment-info">
                            <div class="chip-info">
                                <i class="fa-regular fa-calendar-check"></i>
                                <div class="appointment-info-text">
                                    <span>@item.recordDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        </div>
                        <div class="history-card-footer">
                            <button class="btn-review" @onclick="() => OpenReview(item)">
                                <i class="fa-regular fa-star"></i>
                                <span>@Loc["Review"]</span>
                            </button>
                        </div>
                    </div>
                }
            }
        }
        else if (AllHistory?.result?.Any() == false)
        {
            <p>@Loc["NoRecordsFound"]</p>
        }
    </div>
</div>

@if (warningModalIsOpen)
{
    <div class="modal-backdrop" @onclick="CloseWarningModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-icon">
                <i class="fa-solid fa-triangle-exclamation" style="color: var(--color-warning);"></i>
            </div>
            <h3 class="modal-title">@warningModalTitle</h3>
            <p class="modal-message">@warningModalMessage</p>
            <div class="modal-actions">
                <button class="btn-ok" @onclick="CloseWarningModal">@Loc["Ok"]</button>
            </div>
        </div>
    </div>
}

@if (isReviewModalOpen && selectedReviewItem != null)
{
    <ReviewModal IsOpen="isReviewModalOpen"
                 ItemName="@selectedReviewItem.itemName"
                 Branch="@selectedReviewItem.branch"
                 ReviewUrl="@selectedReviewItem.reviewUrl"
                 ServiceRecordId="@selectedReviewItem.serviceRecordID"
                 OnClose="CloseReviewModal" />
}




