@page "/history/details/{HistoryId:int}"
@inject NavigationManager navigationManager
@inject IJSRuntime JS
@layout EmptyLayout



<div class="page-wrapper">

    <!-- Header -->
    <div class="appointment-header header-with-action">
        <div class="header-left">
            <button class="btn-back" @onclick="GoBack">
                <i class="fa-solid fa-angle-left"></i>
            </button>
            <span>Purchase Details</span>
        </div>

        <button class="btn-print" @onclick="PrintPage">
            <i class="fa-solid fa-print"></i>
        </button>
    </div>

    <!-- Product / Shop Summary -->
    <div class="details-card">
        <div class="details-header">
            <img class="company-image" src="_content/SenangMemberApp.Shared/Images/7455353.jpg" />

            <div class="details-title ms-3">
                <span class="card-name">Wellness Spa Center</span>
                <span class="card-branch">Full Body Massage</span>
            </div>

            <div class="details-price">
                $120.00
            </div>
        </div>

        <div class="details-status">
            <i class="fa-regular fa-calendar-check"></i>
            <div>
                <span>12 Oct 2023</span>
                <span class="status-text completed">Completed</span>
            </div>
        </div>
    </div>

    <!-- Order Info -->
    <div class="details-section">
        <h6>Order Information</h6>

        <div class="details-row">
            <span>Order ID</span>
            <span>#HIS-102349</span>
        </div>

        <div class="details-row">
            <span>Payment Method</span>
            <span>Credit Card</span>
        </div>

        <div class="details-row">
            <span>Total Paid</span>
            <span class="fw-bold">$120.00</span>
        </div>
    </div>

</div>

@code {
    [Parameter]
    public int HistoryId { get; set; }

    void GoBack()
    {
        navigationManager.NavigateTo("/history");
    }
    async Task PrintPage()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
