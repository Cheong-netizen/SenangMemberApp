@page "/home"

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<Home> Loc

<div class="page-wrapper">
    <div class="header">
        <div class="welcome-header">
            <h1 class="welcome-text">@Loc["WelcomeBack"]</h1>
            <span class="welcome-name">
                @if (userProfileData != null && userProfileData.AccountName != null)
                {
                    @userProfileData.AccountName
                }
            </span>
        </div>
        <span @onclick="navAnnouncement" class="bg-white bell-icon"><i class="fa-solid fa-bell"></i></span>
    </div>
    <div class="shop-wrapper">
        <div @onclick="() => { if (!loading) toggleShopListModal(); }" class="shop-dropdown" style="@(loading ? "opacity: 0.5; cursor: not-allowed;" : "cursor: pointer;")">
            <div class="shop-dropdown-placeholder">
                @if(loading){
                    <div class="spinner-container">
                        <div class="loader"></div>
                    </div>
                }
                else
                {
                    @if (currentShopId == "")
                    {
                        <span>@Loc["SelectAShop"]</span>
                        <span><i class="fa-solid fa-caret-down"></i></span>
                    }
                    else
                    {
                        <span>@currentShopName</span>
                        <span><i class="fa-solid fa-caret-down"></i></span>
                    }
                }
            </div>
        </div>
    </div>
    @if (currentShopId != "0")
    {
        <div class="digital-points-wrapper">
            <div @onclick="navCredit" class="digital-points-grid">
                <span><i class="fa-solid fa-dollar-sign"></i>@ShopState.currentMemberBalance.creditBalance</span>
                <span>@Loc["Credits"]</span>
            </div>
            <div class="digital-points-grid">
                <span><i class="fa-regular fa-star"></i>@ShopState.currentMemberBalance.pointBalance</span>
                <span>@Loc["Points"]</span>
            </div>
            <div @onclick="navPackage" class="digital-points-grid">
                <span><i class="fa-regular fa-rectangle-list"></i>@ShopState.currentPackageBalance.ToString("0")</span>
                <span>@Loc["Packages"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="quick-action-wrapper">
            <div class="quick-button-wrapper">
                <div @onclick="navCatalog" class="quick-button">
                    <i class="fa-solid fa-list-ul"></i>
                    <span>@Loc["Catalog"]</span>
                </div>
            </div>
        </div>
    }

    @if (currentShopId != "0")
    {
        <div class="appointment-wrapper">
            <div class="appointment-header">
                <span class="title-text">@Loc["AppointmentTitle"]</span>
                <div @onclick="navAppointment" class="clickable-text">
                    <span>@Loc["SeeAll"]</span>
                    <i class="fa-solid fa-angle-right"></i>
                </div>
            </div>
            @if (loading)
            {
                <div class="spinner-container">
                    <div class="loader"></div>
                </div>
            }
            else
            {
                @if (allUpcomingAppointments != null && allUpcomingAppointments.Count() >= 1)
                {
                    @foreach (var appointment in allUpcomingAppointments.Take(1))
                    {
                        <div class="appointment-list">
                            <div class="appointment-card">
                                <div class="appointment-card-header">
                                    <div class="appointment-image-name">

                                        <div class="appointment-name-info">
                                            <span class="card-name">
                                                @ShopState.CurrentShopName
                                            </span>
                                            <span class="card-branch">
                                                @GetBranchName(appointment.appointmentLocation)
                                            </span>
                                        </div>
                                    </div>

                                    <i class="fa-solid fa-ellipsis"
                                       @onclick="() => OpenAppointmentMoreModal(appointment)" @onclick:stopPropagation="true"></i>
                                </div>

                                <div class="appointment-info">
                                    <div class="chip-info">
                                        <i class="fa-regular fa-calendar"></i>
                                        <div class="appointment-info-text">
                                            <span>
                                                @appointment.startTime.ToString("dd/MM/yyyy")
                                            </span>
                                            <span class="appointment-info-subtitle">
                                                @appointment.startTime.ToString("dddd")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="chip-info">
                                        <i class="fa-regular fa-clock"></i>
                                        <div class="appointment-info-text">
                                            <span>
                                                <span>
                                                    @appointment.startTime.ToString("HH:mm") - @appointment.endTime.ToString("HH:mm")
                                                </span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @* --- Empty State Display --- *@
                    <div class="no-appointment-container">
                        <i class="fa-regular fa-calendar-xmark no-appointment-icon"></i>
                        <p class="no-appointment-text">@Loc["NoUpcomingAppointments"]</p>
                        <button class="book-now-btn" @onclick="navAppointment">@Loc["BookNow"]</button>
                    </div>
                }
            }
            
        </div>
    }
    @* <div class="catalog-wrapper">
        <div class="appointment-header">
            <span class="title-text">@Loc["Catalog"]</span>
            <div @onclick="navCatalog" class="clickable-text">
                <span>@Loc["SeeAll"]</span>
                <i class="fa-solid fa-angle-right"></i>
            </div>
        </div>
        <div class="catalog-item-wrapper">
            @for(int i = 0; i < 3;i++)
                {
                <div class="catalog-tiles">
                        <div class="catalog-card">
                            <img class="catalog-image" src="_content/SenangMemberApp.Shared/Images/store_placeholder.png" />
                            <div class="catalog-info">
                                <span class="catalog-name">@services[i].Name</span>
                                <span class="catalog-company-name">@shops.FirstOrDefault(s => s.Id == services[i].ShopId)?.Name</span>
                            </div>
                        </div>
                    </div>
                }

        </div>
    </div> *@
    @* <div class="bottom-nav">
        <div class="nav-item active">
            <i class="fa-solid fa-house"></i>
            <span>@Loc["NavHome"]</span>
        </div>
        <div @onclick="navAppointment" class="nav-item">
            <i class="fa-solid fa-calendar-days"></i>
            <span>@Loc["NavBooking"]</span>
        </div>
        <div class="nav-item">
            <i class="fa-solid fa-receipt"></i>
            <span>@Loc["NavHistory"]</span>
        </div>
        <div class="nav-item">
            <i class="fa-solid fa-user"></i>
            <span>@Loc["NavProfile"]</span>
        </div>
    </div> *@
</div>

@if (shopListModalIsOpen)
{
    <div @onclick="toggleShopListModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper">
            <div class="shop-list-wrapper">
                <div class="modal-top">
                    <div class="left-header-div"></div>
                    <div class="center-header-div"><span>@Loc["SelectShopModalTitle"]</span></div>
                    <div @onclick="toggleShopListModal" class="close-button right-header-div"><i class="fa-solid fa-xmark"></i></div>
                </div>
                <div class="search-wrapper">
                    <div class="search-box">
                        <span><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input class="search-textbox" type="text" placeholder="@Loc["SearchPlaceholder"]" @bind="shopSearchText" @bind:event="oninput" />
                    </div>
                </div>
                <div class="shop-grid-wrapper">
                    @* <div @onclick="selectAllShop" class="shop-grid-layout">
                        <img class="shop-image" src="_content/SenangMemberApp.Shared/Images/store_placeholder.png" />
                        <span class="shop-name">@Loc["AllShops"]</span>
                    </div> *@
                    @foreach (var shop in filteredShops)
                    {
                        <div @onclick="() => selectShop(shop.CompanyCode, shop.ShopName)" class="shop-grid-layout">
                            <img class="shop-image" src="@shop.LogoPath" />
                            <span class="shop-name">@shop.ShopName</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (appointmentMoreModalIsOpen)
{
    <div @onclick="CloseAppointmentMoreModal" class="backdrop">
        <div @onclick:stopPropagation="true" class="modal-wrapper-more">
            <div class="shop-list-wrapper">
                <div class="modal-top">
                    <div class="left-header-div"></div>
                    <div class="center-header-div"><span>@Loc["MoreOptions"]</span></div>
                    <div @onclick="CloseAppointmentMoreModal" class="close-button right-header-div"><i class="fa-solid fa-xmark"></i></div>
                </div>
                <div class="catalog-wrapper">
                    <div class="catalog-item-wrapper">
                        <div class="catalog-tiles" @onclick="OpenMap">
                            <div class="more-options-card">
                                <div class="catalog-info">
                                    <span class="more-option"><i class="fa-regular fa-map"></i> @Loc["Map"]</span>
                                </div>
                            </div>
                        </div>
                        <div class="catalog-tiles" @onclick="OpenCall">
                            <div class="more-options-card">
                                <div class="catalog-info">
                                    <span class="more-option"><i class="fa-solid fa-phone"></i> @Loc["Call"]</span>
                                </div>
                            </div>
                        </div>
                        <div class="catalog-tiles" @onclick="OpenWhatsApp">
                            <div class="more-options-card">
                                <div class="catalog-info">
                                    <span class="more-option"><i class="fa-brands fa-whatsapp"></i> @Loc["Chat"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (warningModalIsOpen)
{
    <div class="modal-backdrop" @onclick="CloseWarningModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-icon">
                <i class="fa-solid fa-triangle-exclamation" style="color: var(--color-warning);"></i>
            </div>
            <h3 class="modal-title">@warningModalTitle</h3>
            <p class="modal-message">@warningModalMessage</p>
            <div class="modal-actions">
                <button class="btn-ok" @onclick="CloseWarningModal">@Loc["Ok"]</button>
            </div>
        </div>
    </div>
}

