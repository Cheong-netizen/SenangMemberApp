@page "/ChangePassword"
@layout EmptyLayout

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<ChangePassword> Loc

<div class="page-wrapper">

    <div class="profile-header">
        <div @onclick="GoBack" style="cursor: pointer;">
            <span><i class="fa-solid fa-angle-left"></i></span>
        </div>
        <div class="profile-header-title">@Loc["PageTitle"]</div>
        <span></span>
    </div>

    <div class="form-section" style="margin-top: 20px;">

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div style="color: #dc3545; background-color: #f8d7da; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 14px;">
                @ErrorMessage
            </div>
        }

        <div class="form-group">
            <label class="form-label">@Loc["CurrentPasswordLabel"]</label>
            <input type="password" class="form-input" @bind="CurrentPassword" placeholder="@Loc["CurrentPasswordPlaceholder"]" />
        </div>

        <div class="form-group">
            <label class="form-label">@Loc["NewPasswordLabel"]</label>
            <input type="password" class="form-input" @bind="NewPassword" placeholder="@Loc["NewPasswordPlaceholder"]" />
        </div>

        <div class="form-group">
            <label class="form-label">@Loc["ConfirmPasswordLabel"]</label>
            <input type="password" class="form-input" @bind="ConfirmPassword" placeholder="@Loc["ConfirmPasswordPlaceholder"]" />
        </div>

    </div>
</div>

<div @onclick="SaveProfile" class="save-button">
    <div class="save-button-content">
        <span>@Loc["UpdateButton"]</span>
    </div>
</div>
