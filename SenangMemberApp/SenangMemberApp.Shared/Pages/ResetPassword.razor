@page "/reset-password"
@layout EmptyLayout

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2 style="font-weight: var(--bold-lg); color: var(--text-main);">Reset Password</h2>
            <p style="color: var(--text-muted); font-size: var(--fontsize-subtitle);">
                Enter your phone number to receive a 6-digit WhatsApp verification code.
            </p>
        </div>

        @if (!isCodeSent)
        {
            <EditForm Model="@this" OnValidSubmit="HandleSendCode">
                <div class="form-group">
                    <label class="form-label form-row">
                        Phone Number
                        <InputText @bind-Value="phoneNumber" class="custom-input" placeholder="e.g. 60183208832" />
                    </label>
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Sending Code...</span>
                    }
                    else
                    {
                        <span>Send WhatsApp Code</span>
                    }
                </button>
            </EditForm>
        }
        else
        {
            <EditForm Model="@this" OnValidSubmit="HandleVerifyCode">
                <div class="form-group">
                    <label class="form-label form-row">
                        6-Digit Verification Code
                        <InputText @bind-Value="inputOtpCode" class="custom-input" placeholder="Enter 6-digit code" maxlength="6" />
                    </label>
                </div>

                <button type="submit" class="btn-login" disabled="@(isLoading || isSuccess)">
                    @if (isLoading)
                    {
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Verify & Submit</span>
                    }
                </button>

                <div style="text-align: center; margin-top: 1rem;">
                    <button type="button" class="btn-resend" @onclick="HandleResendCode" disabled="@isLoading">
                        Resend Code
                    </button>
                </div>
            </EditForm>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert-success">
                @successMessage
            </div>
        }

        <div class="login-footer">
            <a href="/" class="forgot-link">Back to Sign In</a>
        </div>
    </div>
</div>
