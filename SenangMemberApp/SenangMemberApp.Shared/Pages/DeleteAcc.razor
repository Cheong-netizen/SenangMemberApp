@page "/deleteAccount"

@layout EmptyLayout;
@using SenangMemberApp.Shared.Resources.Pages

@using Microsoft.Extensions.Localization


@inject IStringLocalizer<DeleteAcc> Loc

<div class="page-wrapper">

    <div class="profile-header">
        <div @onclick="GoBack" style="cursor: pointer;">
            <span><i class="fa-solid fa-angle-left"></i></span>
        </div>
        <div class="profile-header-title">@Loc["PageTitle"]</div>
        <span></span>
    </div>

    <div class="edit-profile-img-wrapper">
        <div class="img-container">
            <img src="_content/SenangMemberApp.Shared/Images/senang_profile_pic.png" class="edit-profile-pic" />
        </div>
    </div>

    <div class="form-section">

        <div class="delete-warning" style="color: #d9534f; background-color: #fdf7f7; padding: 12px; border: 1px solid #d9534f; border-radius: 6px; margin-bottom: 20px; text-align: center; font-size: 0.9rem;">
            <strong>@Loc["WarningLabel"]</strong> @Loc["WarningText"]
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="color: red; margin-bottom: 15px; text-align: center; font-size: 0.9rem;">
                @errorMessage
            </div>
        }

        <div class="form-group">
            <label class="form-label">@Loc["PhoneNumberLabel"]</label>
            <div class="phone-input-group" @onclick="OpenPhonePad">
                <input type="tel" class="form-input" @bind="phone" placeholder="@Loc["PhoneNumberPlaceholder"]" readonly />
                <button type="button" class="btn-numpad-trigger" @onclick="OpenPhonePad" @onclick:stopPropagation aria-label="Open Keypad">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </button>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">@Loc["PasswordLabel"]</label>
            <input type="password" class="form-input" @bind="password" placeholder="@Loc["PasswordPlaceholder"]" />
        </div>

    </div>
</div>
<div @onclick="OnDeleteClicked" class="save-button">
    <div class="save-button-content">
        <span>@Loc["DeleteButton"]</span>
    </div>
</div>

@if (isDeleteConfirmModalVisible)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-icon">
                <i class="fa-solid fa-triangle-exclamation" style="color: var(--color-danger);"></i>
            </div>
            <h3 class="modal-title">@Loc["DeleteConfirmTitle"]</h3>
            <p class="modal-message">@Loc["DeleteConfirmMessage"]</p>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="CancelDelete">@Loc["Cancel"]</button>
                <button class="btn-confirm" @onclick="ConfirmDelete">@Loc["DeleteButton"]</button>
            </div>
        </div>
    </div>
}

<PhoneNumpad @bind-IsOpen="isPhonePadOpen" PhoneNumber="@phone" OnSave="OnPhoneSelected" />
