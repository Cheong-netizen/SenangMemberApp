<Project>
  <PropertyGroup>
    <!--
      Keep generated paths short. Android produces deeply nested Java wrapper
      paths, and this repository may live below a long OneDrive directory.
    -->
    <ShortProjectName Condition="'$(MSBuildProjectName)' == 'SenangMemberApp'">a</ShortProjectName>
    <ShortProjectName Condition="'$(MSBuildProjectName)' == 'SenangMemberApp.Shared'">s</ShortProjectName>
    <ShortProjectName Condition="'$(MSBuildProjectName)' == 'SenangMemberApp.Web'">w</ShortProjectName>
    <ShortProjectName Condition="'$(ShortProjectName)' == ''">$(MSBuildProjectName)</ShortProjectName>
    <!-- Keep NuGet/MSBuild intermediates machine-local. The repository's legacy o/ files
         contain absolute package paths from another workstation. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).o\$(ShortProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)b\$(ShortProjectName)\</BaseOutputPath>
    <!-- Prevent background MSBuild node processes from locking intermediate Android build files -->
    <MSBuildDisableNodeReuse>true</MSBuildDisableNodeReuse>
  </PropertyGroup>
</Project>
